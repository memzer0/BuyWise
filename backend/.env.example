# Copy to backend/.env and fill in what you have. Every provider is optional:
# the app starts without any of them and tells you which ones need configuring.

DATABASE_URL=sqlite:///./buywise.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://buywise:buywise@localhost:5432/buywise
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
AUTO_MIGRATE=true

# --- Google Shopping India via SerpApi (licensed API, free tier available) ---
# Sign up at https://serpapi.com/ -> Dashboard -> "Your Private API Key"
SERPAPI_API_KEY=
SERPAPI_LOCATION=India
# Opening a product fetches its Google Shopping store list (1 extra search) to get each store's own link
SERPAPI_STORE_LINKS=true
# Sellers ignored because they list accessories (skins/cases) under device names
EXCLUDED_SELLERS=KerfCase,dbrand

# --- Trusted stores ---
# By default only offers from established retailers / official brand stores are shown and used for the lowest price.
# Leave TRUSTED_STORES / TRUSTED_DOMAINS unset to use the built-in list (app/pricing/trust.py), or set your own comma-separated list.
TRUSTED_ONLY=true

# --- Amazon India via Amazon Creators API (official; replaced PA-API 5) ---
# Requires an approved Amazon Associates India account with Creators API access:
# https://affiliate-program.amazon.in -> Tools -> Creators API -> create credentials (Credential ID + Secret)
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
# India uses the EU credential region (v3.2). Change only if Amazon's docs say otherwise for your credentials.
AMAZON_CREATORS_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
AMAZON_MARKETPLACE=www.amazon.in

# --- Flipkart Affiliate API (official) ---
# https://affiliate.flipkart.com -> register -> API Token section (Affiliate Tracking ID + Token)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# --- Fetching / freshness (seconds) ---
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MIN_INTERVAL_SECONDS=1.5
FRESH_WINDOW_SECONDS=1800
STALE_AFTER_SECONDS=86400
SEARCH_CACHE_SECONDS=1800

# --- Automatic refresh ---
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
REFRESH_POPULAR_MINUTES=60
REFRESH_NORMAL_MINUTES=360
# Pre-tracking: re-run these searches on a timer so popular products build real price history.
# 1 SerpApi search each; monthly cost = queries x (720 / PRETRACK_INTERVAL_HOURS). Set PRETRACK_ENABLED=false to stop.
PRETRACK_ENABLED=true
PRETRACK_INTERVAL_HOURS=24
# PRETRACK_QUERIES=iPhone 17, Samsung Galaxy S25, OnePlus 13

# --- Admin diagnostics page (leave empty to disable) ---
ADMIN_TOKEN=

# --- Optional e-mail alerts ---
# E-mail for price alerts and Regret Shield. Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 letters (no spaces) as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# AI shopping assistant (chat bubble). Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# …or use Claude instead (used only if GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
